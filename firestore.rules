rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }
    match /bookings/{id} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['name','mobile','type','fee','status','createdAt','ownerUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() >= 10
        && request.resource.data.mobile.size() <= 20
        && request.resource.data.type in ['online','physical']
        && request.resource.data.fee == (request.resource.data.type == 'online' ? 2000 : 1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if admin();
    }
  }
}
